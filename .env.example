# ---- Frontend environment switching ----
# Mock mode (default): leave everything unset — Nitro routes in server/api/** serve /api/*.

# Real-backend mode (recommended): proxy /api/* to FastAPI server-side, browser stays same-origin.
# NUXT_BACKEND_PROXY_TARGET=http://localhost:8000

# Direct mode (API testing only; cookie auth in the browser requires the proxy above):
# NUXT_PUBLIC_API_BASE=http://localhost:8000/api

# NOTE: switching modes invalidates sessions (mock cookie = raw id, real backend = opaque
# token) — log in again after switching.
